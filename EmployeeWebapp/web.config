<?xml version="1.0" encoding="utf-8"?>
<!--
  Rage N Raze — IT Asset Management IIS Configuration
  ====================================================
  This file configures IIS using the Microsoft HttpPlatformHandler module.
  IIS manages the Python process and forwards web requests to Waitress WSGI.
-->
<configuration>
  <system.webServer>
    <!-- Handlers: forward all web requests to HttpPlatformHandler -->
    <handlers>
      <add name="HttpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!--
      Process Management:
      - processPath: Path to Python executable (e.g., python.exe or C:\Python312\python.exe)
      - arguments: Runs Waitress on the dynamic port assigned by IIS (%HTTP_PLATFORM_PORT%)
      - stdoutLogEnabled: Set to "true" to capture server logs into .\logs
    -->
    <httpPlatform processPath="python.exe"
                  arguments="-m waitress --port=%HTTP_PLATFORM_PORT% wsgi:app"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout.log"
                  startupTimeLimit="120"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="%APPL_PHYSICAL_PATH%" />
        <environmentVariable name="SECRET_KEY" value="rnr-production-secret-key-change-me" />
        <!-- Set to "false" in full production when connected to real Active Directory -->
        <environmentVariable name="ALLOW_LOCAL_DEV_LOGIN" value="true" />

        <!-- Active Directory / LDAP Domain Settings -->
        <!--
        <environmentVariable name="LDAP_SERVER" value="ldap://dc.ragenraze.local" />
        <environmentVariable name="LDAP_DOMAIN" value="RAGENRAZE" />
        <environmentVariable name="LDAP_BASE_DN" value="DC=ragenraze,DC=local" />
        <environmentVariable name="LDAP_USER_SEARCH_BASE" value="OU=Users,DC=ragenraze,DC=local" />
        <environmentVariable name="LDAP_ADMIN_GROUP" value="IT-Admins" />
        <environmentVariable name="LDAP_TECH_GROUP" value="IT-Technicians" />
        <environmentVariable name="LDAP_VIEWER_GROUP" value="IT-Viewers" />
        -->
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Protect SQLite database and sensitive files from direct download -->
          <add segment="instance" />
          <add segment="test_app.py" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
